# Copy to .env.local and fill in. Never commit real values.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Generate: `openssl rand -base64 32`
AUTH_SECRET=

# Public origin used by Auth.js for callbacks. Vercel sets this automatically
# in production. For local dev, use http://localhost:3000.
AUTH_URL=http://localhost:3000

# Database (Vercel Postgres / Neon).
# After linking the project: `vercel env pull .env.local` will populate this.
POSTGRES_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Microsoft Entra SSO (M365 for @chiefspursuitsurplus.com)
# Leave blank to disable. Sign-in page hides the button when unconfigured.
# ─────────────────────────────────────────────────────────────────────────────
# 1. portal.azure.com → Microsoft Entra ID → App registrations → New registration
# 2. Redirect URI (Web): https://<your-domain>/api/auth/callback/microsoft-entra-id
# 3. Add a client secret. Copy the *Value*, not the ID.
# 4. Issuer URL: https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Email magic-link for personal-email employees
# Leave blank to disable. Use Resend, SendGrid, or M365 SMTP.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Vercel Blob (file storage for invoices / build specs)
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Microsoft Graph mail sync (feeds sales email into /communications)
# Leave blank to disable; manual call/email logging still works without it.
# ─────────────────────────────────────────────────────────────────────────────
# App-only (client credentials), NOT delegated — the sync runs unattended on a
# cron with nobody signed in.
#
# 1. portal.azure.com → Entra ID → App registrations → New registration
#    (single tenant, no redirect URI needed — there's no interactive sign-in).
# 2. API permissions → Microsoft Graph → APPLICATION permissions →
#    Mail.Read + User.Read.All → Grant admin consent.
# 3. Certificates & secrets → New client secret. Copy the *Value*.
# 4. IMPORTANT — scope the app to the sales mailboxes only. Without this the
#    credential can read every mailbox in the tenant. In Exchange Online
#    PowerShell:
#      New-DistributionGroup -Name "CRM Synced Mailboxes" -Type Security
#      Add-DistributionGroupMember -Identity "CRM Synced Mailboxes" -Member sales@chiefspursuitsurplus.com
#      New-ApplicationAccessPolicy -AppId <GRAPH_CLIENT_ID> \
#        -PolicyScopeGroupId "CRM Synced Mailboxes" -AccessRight RestrictAccess \
#        -Description "CRM email ingest"
# 5. Register each mailbox on /communications → Add mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Domains treated as internal. A thread whose every participant is internal is
# never ingested — that's colleagues talking, not sales activity.
# Comma-separated. Defaults to chiefspursuitsurplus.com.
INTERNAL_EMAIL_DOMAINS=chiefspursuitsurplus.com

# known_contacts (default) — only store mail where a participant already
#   matches a customer contact or a lead. Nothing else is written.
# all_external    — store anything with an external participant; unmatched mail
#   waits in the /communications triage queue.
COMM_INGEST_SCOPE=known_contacts

# How far back the FIRST sync of a mailbox reaches, in days. Every run after
# that is incremental (Graph delta), so this only bounds the initial backfill.
COMM_BACKFILL_DAYS=30

# Required for the mail-sync cron (Vercel sends it as a Bearer token).
# Generate: `openssl rand -hex 32`
CRON_SECRET=
