# Copy to .env.local and fill in. Never commit real values.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Generate: `openssl rand -base64 32`
AUTH_SECRET=

# Public origin used by Auth.js for callbacks. Vercel sets this automatically
# in production. For local dev, use http://localhost:3000.
AUTH_URL=http://localhost:3000

# Database (Vercel Postgres / Neon).
# After linking the project: `vercel env pull .env.local` will populate this.
POSTGRES_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Microsoft Entra SSO (M365 for @chiefspursuitsurplus.com)
# Leave blank to disable. Sign-in page hides the button when unconfigured.
# ─────────────────────────────────────────────────────────────────────────────
# 1. portal.azure.com → Microsoft Entra ID → App registrations → New registration
# 2. Redirect URI (Web): https://<your-domain>/api/auth/callback/microsoft-entra-id
# 3. Add a client secret. Copy the *Value*, not the ID.
# 4. Issuer URL: https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Email magic-link for personal-email employees
# Leave blank to disable. Use Resend, SendGrid, or M365 SMTP.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Vercel Blob (file storage for invoices / build specs)
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Shopify storefront lead intake (/api/leads/{contact,parts-inquiry,
# inventory-inquiry,vehicle-inquiry}) — see src/lib/leads/intake.ts
# ─────────────────────────────────────────────────────────────────────────────
# Hosts we may redirect visitors back to after a form post (comma-separated).
# When the custom domain goes live, ADD it here, e.g.
# chiefs-pursuit-surplus.myshopify.com,www.chiefspursuitsurplus.com
ALLOWED_REDIRECT_HOSTS=chiefs-pursuit-surplus.myshopify.com
# Full URL visitors land on when page_url is missing or not allowed.
PUBLIC_SITE_URL=https://chiefs-pursuit-surplus.myshopify.com
# Salt for hashing visitor IPs. Random, 32+ chars (`openssl rand -hex 32`). Never change once set.
IP_HASH_SALT=
# Optional: Resend API key — turns on new-lead email alerts.
RESEND_API_KEY=
# Optional: inbox that receives new-lead alerts (e.g. sales@chiefspursuitsurplus.com).
LEAD_NOTIFY_EMAIL=
# Optional: sender address for alerts; must be verified in Resend.
LEAD_NOTIFY_FROM=
