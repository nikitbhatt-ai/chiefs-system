# Copy to .env.local and fill in. Never commit real values.

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Generate: `openssl rand -base64 32`
AUTH_SECRET=

# Public origin used by Auth.js for callbacks. Vercel sets this automatically
# in production. For local dev, use http://localhost:3000.
AUTH_URL=http://localhost:3000

# ── Microsoft Entra (M365 SSO for @chiefspursuitsurplus.com employees) ───────
# 1. portal.azure.com → Microsoft Entra ID → App registrations → New registration
# 2. Redirect URI (Web): https://<your-vercel-domain>/api/auth/callback/microsoft-entra-id
# 3. Add a client secret. Copy the *Value*, not the ID.
# 4. Issuer URL: https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ── Email magic-link (for personal-email employees) ──────────────────────────
# Use any SMTP. Recommended: Resend (resend.com) or Microsoft 365 SMTP.
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Chiefs Pursuit Surplus <noreply@chiefspursuitsurplus.com>"

# ── Database (Vercel Postgres / Neon) ────────────────────────────────────────
# `vercel env pull .env.local` after linking to your Vercel project
# auto-populates this.
POSTGRES_URL=

# ── Vercel Blob (file storage for invoices / build specs) ────────────────────
BLOB_READ_WRITE_TOKEN=
