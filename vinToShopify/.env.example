# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# NEVER commit your real .env file — it's ignored by git on purpose.

# Your store's myshopify domain. With or without https:// is fine.
#   example: chiefs-pursuit-surplus.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# An Admin API access token from a custom app in your Shopify admin.
# Needs the "write_products" scope (and "write_inventory" if you later manage
# inventory levels explicitly). Looks like: shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ADMIN_TOKEN=shpat_your_admin_api_access_token
