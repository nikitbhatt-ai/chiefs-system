# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# NEVER commit your real .env file — it's ignored by git on purpose.

# Your store's myshopify domain. With or without https:// is fine.
#   example: chiefs-pursuit-surplus.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Your Dev Dashboard app's Client ID and Client Secret.
# Find them at: dev.shopify.com/dashboard -> your app -> Settings -> Credentials.
# The app must be INSTALLED on the store above (App overview -> Installs ->
# "Install app") and have the "write_products" scope.
#
# Our code uses these to do a client_credentials OAuth exchange and receive a
# short-lived (24h) Admin API access token. You never paste an "admin token"
# yourself anymore — that's the new Dev Dashboard flow.
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here
